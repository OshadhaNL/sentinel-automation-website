DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_DATABASE_PASSWORD@localhost:5432/sentinel_dashboard
ADMIN_EMAIL=admin@northlark.com
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
TESTER_EMAIL=tester@northlark.com
TESTER_PASSWORD=CHANGE_TESTER_PASSWORD

# Start with simulated executions; switch to pytest after verifying classifications.
EXECUTION_PROVIDER=mock
# Absolute paths to the existing automation project and its OWN environment:
AUTOMATION_ROOT=C:/Users/Oshadha Weerakoon/Desktop/sentinel-automation-full/testing
AUTOMATION_PYTHON=C:/Users/Oshadha Weerakoon/Desktop/sentinel-automation-full/testing/.venv/Scripts/python.exe
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SECURE_COOKIES=0
REAL_CAMERA_AVAILABLE=0

# outbox saves local email files; graph sends via Microsoft 365; smtp uses TLS.
MAIL_MODE=outbox
PUBLIC_APP_URL=http://127.0.0.1:5173
MAIL_FROM=sentinel@northlark.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=0

# Microsoft 365 app registration (for MAIL_MODE=graph).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
